# Copy to `.env` (or just export these) before running against a real backend.
# Nothing in the offline demo/tests reads these, so the repo is runnable
# without any credentials.

# --- Alibaba Cloud Bailian / DashScope (OpenAI-compatible) ---------------
ART_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ART_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Text model for the translation agents.
ART_LLM_MODEL=qwen-plus
# Vision-language model for page layout analysis + chart reading.
ART_VLM_MODEL=qwen2.5-vl-72b-instruct

# --- Parser backend selection -------------------------------------------
# one of: mock | qwen-vl | paddle
ART_PARSER_BACKEND=qwen-vl
# DPI used when rasterising PDF pages before VLM analysis (150-200 is a good
# quality/cost trade-off for dense financial tables).
ART_PDF_DPI=180

# --- HITL ---------------------------------------------------------------
# Risk score in [0,1]; chunks at or above this go to the human review queue.
ART_HITL_THRESHOLD=0.45
